      "source": "10.1016/j.ensm.2022.05.007",
      "claim": "Future operating conditions may improve trajectory prediction only when they are declared at prediction time; realized future conditions remain oracle diagnostics."
    },
    {
      "hypothesis_id": "H5_active_experiment_selection",
      "source": "10.1038/s41586-025-09951-7",
      "claim": "A diversity-and-uncertainty acquisition policy can reduce the number of complete-life experiments needed for a fixed predictive performance target without querying the locked test."
    },
