      "temperature_chamber_id"
    ]
  },
  "noise_model_selection": {
    "selection_unit": "physical_cell_id",
    "selection_metric": "leave_one_physical_cell_out_log_score",
    "candidate_families": [
      {
        "model_id": "zero_mean_gaussian",
        "distribution": "gaussian"
      },
      {
        "model_id": "zero_mean_student_t_df3",
        "distribution": "student_t",
