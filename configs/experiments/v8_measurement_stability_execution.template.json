      },
      {
        "model_id": "zero_mean_student_t_df5",
        "distribution": "student_t",
        "degrees_of_freedom": 5.0
      },
      {
        "model_id": "zero_mean_student_t_df10",
        "distribution": "student_t",
        "degrees_of_freedom": 10.0
      }
    ],
    "minimum_scale_pp": 1e-06,
    "tie_tolerance_log_score": 1e-09,
    "tie_break_order": [
      "zero_mean_gaussian",
      "zero_mean_student_t_df10",
      "zero_mean_student_t_df5",
      "zero_mean_student_t_df3"
    ]
  },
  "drift_quality_gates": {
    "maximum_median_absolute_repeat_order_slope_pp_per_repeat": 0.01,
    "maximum_absolute_daily_reference_shift_pp": 0.05,
