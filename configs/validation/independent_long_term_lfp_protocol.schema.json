        "requires_individual_physical_cell_ids": {
          "const": true
        },
        "requires_separable_calendar_aging": {
          "const": true
        },
        "requires_machine_readable_observations": {
          "const": true
        },
        "minimum_physical_cells": {
          "const": 8
        },
        "minimum_independent_scoring_clusters": {
          "const": 8
        },
        "minimum_positive_prefix_observations": {
          "const": 4
        },
        "minimum_future_observations": {
          "type": "integer",
          "minimum": 2
        },
