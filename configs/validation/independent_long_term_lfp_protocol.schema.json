    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_coverages",
        "calibration_unit",
        "route_conditional",
        "score",
        "quantile_rule",
        "diagnostic_interval_allowed",
        "operational_issuance",
        "rejection_reasons"
      ],
      "properties": {
        "requested_coverages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0.5,
            "exclusiveMaximum": 1
          }
        },
        "calibration_unit": {
          "const": "independent_cluster"
        },
        "route_conditional": {
          "const": true
        },
        "score": {
          "const": "cluster_maximum_standardized_error_over_frozen_future_horizon"
        },
        "quantile_rule": {
          "const": "ceil((n+1)*coverage)_higher_or_unavailable"
        },
        "diagnostic_interval_allowed": {
          "type": "boolean"
        },
        "operational_issuance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled_at_freeze",
            "allowed_outcome_blindness_classes",
            "minimum_calibration_clusters_per_route",
            "minimum_audit_clusters_per_route",
            "cluster_independence_definition",
            "maximum_absolute_coverage_shortfall",
            "requires_horizon_match",
            "requires_covariate_support",
            "requires_point_success",
            "requires_independent_calibration",
            "all_gates_required"
          ],
          "properties": {
            "enabled_at_freeze": {
              "type": "boolean"
            },
            "allowed_outcome_blindness_classes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "prospective_outcome_blind",
                  "public_but_project_blind"
                ]
              }
            },
            "minimum_calibration_clusters_per_route": {
              "type": "integer",
              "minimum": 20
            },
            "minimum_audit_clusters_per_route": {
              "type": "integer",
              "minimum": 20
            },
            "cluster_independence_definition": {
              "type": "string",
              "minLength": 20
            },
            "maximum_absolute_coverage_shortfall": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.1
            },
            "requires_horizon_match": {
              "const": true
            },
            "requires_covariate_support": {
              "const": true
            },
            "requires_point_success": {
              "const": true
            },
            "requires_independent_calibration": {
              "const": true
            },
            "all_gates_required": {
              "const": true
            }
          }
        },
        "rejection_reasons": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "input_quality_failure",
              "prefix_too_short",
              "unsupported_temperature_soc_or_cell_type",
              "specialist_gate_not_ready",
              "same_route_calibration_insufficient",
              "calibration_horizon_mismatch",
              "nonfinite_quantile",
              "prediction_interval_too_wide",
              "independent_validation_missing",
              "protocol_or_hash_verification_failure"
            ]
          }
        }
      }
