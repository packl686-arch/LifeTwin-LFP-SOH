{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/packl686-arch/LifeTwin-LFP-SOH/configs/validation/independent_long_term_lfp_protocol.schema.json",
  "title": "LifeTwin independent long-term LFP validation protocol",
  "description": "Dataset-agnostic schema for freezing a long-horizon LFP/graphite calendar-aging evaluation before target outcomes are linked.",
  "x-lifetwin-semantic-validator": "lifetwin.validation.long_term_protocol.validate_independent_long_term_protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "status",
    "protocol_freeze",
    "dataset",
    "eligibility",
    "outcome_blindness",
    "partitions",
    "landmarks",
    "candidate",
    "baselines",
    "metrics",
    "decision_rules",
    "uncertainty",
    "claim_boundaries",
    "execution_record"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "protocol_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{7,127}$"
    },
    "status": {
      "enum": [
        "draft",
        "frozen",
        "executed",
        "void"
      ]
    },
    "protocol_freeze": {
      "$ref": "#/$defs/protocol_freeze"
    },
    "dataset": {
      "$ref": "#/$defs/dataset"
    },
    "eligibility": {
      "$ref": "#/$defs/eligibility"
    },
    "outcome_blindness": {
      "$ref": "#/$defs/outcome_blindness"
    },
    "partitions": {
      "$ref": "#/$defs/partitions"
    },
    "landmarks": {
      "$ref": "#/$defs/landmarks"
    },
    "candidate": {
      "$ref": "#/$defs/model_spec"
    },
    "baselines": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "model_id",
              "role"
            ],
            "properties": {
              "model_id": {
                "const": "target_prefix_persistence"
              },
              "role": {
                "const": "mandatory_baseline"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "model_id",
              "role"
            ],
            "properties": {
              "model_id": {
                "const": "target_prefix_sqrt_time"
              },
              "role": {
                "const": "mandatory_baseline"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "model_id",
              "role"
            ],
            "properties": {
              "model_id": {
                "const": "target_prefix_bounded_power_law"
              },
              "role": {
                "const": "mandatory_baseline"
              }
            }
          }
        }
      ],
      "items": {
        "$ref": "#/$defs/model_spec"
      }
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    },
    "decision_rules": {
      "$ref": "#/$defs/decision_rules"
    },
    "uncertainty": {
      "$ref": "#/$defs/uncertainty"
    },
    "claim_boundaries": {
      "$ref": "#/$defs/claim_boundaries"
    },
    "execution_record": {
      "$ref": "#/$defs/execution_record"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "eligibility": {
            "properties": {
              "observed_result": {
                "const": "eligible"
              }
            },
            "required": [
              "observed_result"
            ]
          }
        },
        "required": [
          "eligibility"
        ]
      },
      "then": {
        "$ref": "#/$defs/eligible_protocol_gates"
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "frozen",
              "executed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "protocol_freeze": {
            "properties": {
              "frozen_at_utc": {
                "$ref": "#/$defs/date_time"
              },
              "git_commit_sha": {
                "$ref": "#/$defs/git_sha"
              },
              "protocol_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "model_bundle_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "scorer_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "adapter_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "environment_lock_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "dataset": {
            "properties": {
              "repository_version": {
                "not": {
                  "const": "REPLACE_BEFORE_FREEZE"
                }
              },
              "access_mode": {
                "not": {
                  "const": "not_acquired"
                }
              },
              "data_license": {
                "properties": {
                  "status": {
                    "enum": [
                      "explicit",
                      "permission_granted"
                    ]
                  }
                }
              },
              "artifacts": {
                "minItems": 1
              },
              "cathode_chemistry": {
                "not": {
                  "const": "REPLACE_BEFORE_FREEZE"
                }
              },
              "anode_chemistry": {
                "not": {
                  "const": "REPLACE_BEFORE_FREEZE"
                }
              },
              "physical_cell_id_field": {
                "not": {
                  "const": "REPLACE_BEFORE_FREEZE"
                }
              },
              "maximum_observed_duration_days": {
                "type": "number",
                "minimum": 730
              }
            }
          },
          "eligibility": {
            "properties": {
              "observed_result": {
                "const": "eligible"
              },
              "evidence_tier": {
                "enum": [
                  "D3_long_horizon_trajectory_retrospective",
                  "D4_locked_external_trajectory",
                  "D5_prospective_operational"
                ]
              },
              "failure_reasons": {
                "const": []
              }
            }
          },
          "outcome_blindness": {
            "properties": {
              "classification": {
                "enum": [
                  "prospective_outcome_blind",
                  "public_but_project_blind",
                  "locked_retrospective_replication"
                ]
              }
            }
          },
          "landmarks": {
            "properties": {
              "primary_value": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "common_score_start": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "common_score_end": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "candidate": {
            "properties": {
              "implementation_revision": {
                "not": {
                  "const": "REPLACE_BEFORE_FREEZE"
                }
              },
              "config_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "hyperparameters_frozen": {
                "const": true
              }
            }
          },
          "baselines": {
            "items": {
              "properties": {
                "implementation_revision": {
                  "not": {
                    "const": "REPLACE_BEFORE_FREEZE"
                  }
                },
                "config_sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "hyperparameters_frozen": {
                  "const": true
                }
              }
            }
          },
          "claim_boundaries": {
            "properties": {
              "maximum_claim_horizon_days": {
                "type": "number",
                "minimum": 0
              },
              "claim_horizon_within_observed_support": {
                "const": true
              },
              "fifteen_to_twenty_five_year_claim_allowed": {
                "const": false
              },
              "prohibited_claims": {
                "contains": {
                  "const": "15_to_25_year_accuracy_without_observed_support"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "executed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "execution_record": {
            "properties": {
              "prediction_bundle_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "prediction_frozen_at_utc": {
                "$ref": "#/$defs/date_time"
              },
              "truth_linked_at_utc": {
                "$ref": "#/$defs/date_time"
              },
              "result_bundle_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "truth_linked_after_prediction_freeze": {
                "const": true
              },
              "independent_scorer_verified": {
                "const": true
              },
              "terminal_decision": {
                "enum": [
                  "success",
                  "failure",
                  "inconclusive",
                  "void"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "status": {
                "const": "executed"
              }
            },
            "required": [
              "status"
            ]
          },
          {
            "properties": {
              "execution_record": {
                "properties": {
                  "terminal_decision": {
                    "const": "success"
                  }
                },
                "required": [
                  "terminal_decision"
                ]
              }
            },
            "required": [
              "execution_record"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "eligibility": {
            "properties": {
              "observed_result": {
                "const": "eligible"
              }
            }
          },
          "candidate": {
            "properties": {
              "hyperparameters_frozen": {
                "const": true
              }
            }
          },
          "baselines": {
            "items": {
              "properties": {
                "hyperparameters_frozen": {
                  "const": true
                }
              }
            }
          },
          "execution_record": {
            "properties": {
              "independent_scorer_verified": {
                "const": true
              },
              "point_success_gates_passed": {
                "const": true
              },
              "landmark_consistency_gates_passed": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "status": {
                "const": "executed"
              }
            }
          },
          {
            "properties": {
              "execution_record": {
                "properties": {
                  "terminal_decision": {
                    "const": "success"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "uncertainty": {
                "properties": {
                  "operational_issuance": {
                    "properties": {
                      "enabled_at_freeze": {
                        "const": true
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "then": {
        "properties": {
          "execution_record": {
            "properties": {
              "formal_interval_gates_passed": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome_blindness": {
            "properties": {
              "classification": {
                "const": "prospective_outcome_blind"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "eligibility": {
            "properties": {
              "evidence_tier": {
                "const": "D5_prospective_operational"
              }
            }
          },
          "outcome_blindness": {
            "properties": {
              "allowed_claim_role": {
                "const": "confirmatory"
              }
            }
          },
          "claim_boundaries": {
            "properties": {
              "allowed_claims": {
                "contains": {
                  "const": "prospective_outcome_blind_confirmation"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome_blindness": {
            "properties": {
              "classification": {
                "const": "public_but_project_blind"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "eligibility": {
            "properties": {
              "evidence_tier": {
                "const": "D4_locked_external_trajectory"
              }
            }
          },
          "outcome_blindness": {
            "properties": {
              "allowed_claim_role": {
                "const": "locked_external_confirmation_with_public_data_caveat"
              }
            }
          },
          "claim_boundaries": {
            "properties": {
              "allowed_claims": {
                "allOf": [
                  {
                    "contains": {
                      "const": "public_data_project_blind_locked_confirmation"
                    }
                  },
                  {
                    "not": {
                      "contains": {
                        "const": "prospective_outcome_blind_confirmation"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome_blindness": {
            "properties": {
              "classification": {
                "const": "locked_retrospective_replication"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "eligibility": {
            "properties": {
              "evidence_tier": {
                "const": "D3_long_horizon_trajectory_retrospective"
              }
            }
          },
          "outcome_blindness": {
            "properties": {
              "allowed_claim_role": {
                "const": "retrospective_replication"
              }
            }
          },
          "claim_boundaries": {
            "properties": {
              "allowed_claims": {
                "allOf": [
                  {
                    "contains": {
                      "const": "locked_retrospective_replication"
                    }
                  },
                  {
                    "not": {
                      "contains": {
                        "const": "prospective_outcome_blind_confirmation"
                      }
                    }
                  },
                  {
                    "not": {
                      "contains": {
                        "const": "public_data_project_blind_locked_confirmation"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome_blindness": {
            "properties": {
              "classification": {
                "const": "development_only"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "outcome_blindness": {
            "properties": {
              "allowed_claim_role": {
                "const": "hypothesis_generation_only"
              }
            }
          },
          "claim_boundaries": {
            "properties": {
              "allowed_claims": {
                "allOf": [
                  {
                    "not": {
                      "contains": {
                        "const": "prospective_outcome_blind_confirmation"
                      }
                    }
                  },
                  {
                    "not": {
                      "contains": {
                        "const": "public_data_project_blind_locked_confirmation"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome_blindness": {
            "properties": {
              "classification": {
                "const": "unclassifiable"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "outcome_blindness": {
            "properties": {
              "allowed_claim_role": {
                "const": "none"
              }
            }
          },
          "claim_boundaries": {
            "properties": {
              "allowed_claims": {
                "const": []
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "claim_boundaries": {
            "properties": {
              "allowed_claims": {
                "contains": {
                  "const": "operational_interval_coverage_after_all_gates"
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "executed"
          },
          "uncertainty": {
            "properties": {
              "operational_issuance": {
                "properties": {
                  "enabled_at_freeze": {
                    "const": true
                  }
                }
              }
            }
          },
          "execution_record": {
            "properties": {
              "formal_interval_gates_passed": {
                "const": true
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "eligible_protocol_gates": {
      "type": "object",
      "properties": {
        "dataset": {
          "properties": {
            "cathode_chemistry": {
              "const": "LFP"
            },
            "anode_chemistry": {
              "const": "graphite"
            },
            "aging_mode": {
              "const": "controlled_calendar"
            },
            "machine_readable_observations_verified": {
              "const": true
            },
            "physical_cell_ids_verified": {
              "const": true
            },
            "calendar_aging_separable_verified": {
              "const": true
            },
            "observed_physical_cell_count": {
              "type": "integer",
              "minimum": 8
            },
            "observed_independent_scoring_cluster_count": {
              "type": "integer",
              "minimum": 8
            },
            "minimum_observed_positive_prefix_observations": {
              "type": "integer",
              "minimum": 4
            },
            "minimum_observed_future_observations": {
              "type": "integer",
              "minimum": 2
            },
            "minimum_observed_future_to_landmark_time_ratio": {
              "type": "number",
              "minimum": 2.0
            }
          }
        },
        "partitions": {
          "properties": {
            "training_ids": {
              "minItems": 1
            },
            "calibration_ids": {
              "minItems": 1
            },
            "test_ids": {
              "minItems": 1
            },
            "audit_ids": {
              "minItems": 1
            },
            "assigned_unit_count": {
              "type": "integer",
              "minimum": 4
            },
            "pairwise_disjoint_verified": {
              "const": true
            }
          }
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "date_time": {
      "type": "string",
      "format": "date-time"
    },
    "nullable_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_git_sha": {
      "oneOf": [
        {
          "$ref": "#/$defs/git_sha"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_date_time": {
      "oneOf": [
        {
          "$ref": "#/$defs/date_time"
        },
        {
          "type": "null"
        }
      ]
    },
    "protocol_freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frozen_at_utc",
        "git_commit_sha",
        "protocol_sha256",
        "model_bundle_sha256",
        "scorer_sha256",
        "adapter_sha256",
        "environment_lock_sha256",
        "freeze_witnesses",
        "amendments"
      ],
      "properties": {
        "frozen_at_utc": {
          "$ref": "#/$defs/nullable_date_time"
        },
        "git_commit_sha": {
          "$ref": "#/$defs/nullable_git_sha"
        },
        "protocol_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "model_bundle_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "scorer_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "adapter_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "environment_lock_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "freeze_witnesses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "amendments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "amendment_id",
              "timestamp_utc",
              "reason",
              "target_outcomes_exposed_before_change",
              "downgrade"
            ],
            "properties": {
              "amendment_id": {
                "type": "string"
              },
              "timestamp_utc": {
                "$ref": "#/$defs/date_time"
              },
              "reason": {
                "type": "string",
                "minLength": 10
              },
              "target_outcomes_exposed_before_change": {
                "type": "boolean"
              },
              "downgrade": {
                "enum": [
                  "none",
                  "locked_retrospective_replication",
                  "development_only",
                  "void"
                ]
              }
            }
          }
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "identifier",
        "url",
        "scope_note"
      ],
      "properties": {
        "status": {
          "enum": [
            "explicit",
            "permission_granted",
            "unclear",
            "restricted",
            "not_published"
          ]
        },
        "identifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "scope_note": {
          "type": "string",
          "minLength": 5
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_name",
        "source_url",
        "repository_version",
        "byte_size",
        "sha256",
        "retrieved_at_utc"
      ],
      "properties": {
        "logical_name": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "repository_version": {
          "type": "string",
          "minLength": 1
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "retrieved_at_utc": {
          "$ref": "#/$defs/date_time"
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "title",
        "doi_or_persistent_url",
        "repository_url",
        "repository_version",
        "access_mode",
        "paper_license",
        "data_license",
        "artifacts",
        "cathode_chemistry",
        "anode_chemistry",
        "aging_mode",
        "time_unit",
        "physical_cell_id_field",
        "condition_id_fields",
        "outcome_fields",
        "maximum_observed_duration_days",
        "machine_readable_observations_verified",
        "physical_cell_ids_verified",
        "calendar_aging_separable_verified",
        "observed_physical_cell_count",
        "observed_independent_scoring_cluster_count",
        "minimum_observed_positive_prefix_observations",
        "minimum_observed_future_observations",
        "minimum_observed_future_to_landmark_time_ratio"
      ],
      "properties": {
